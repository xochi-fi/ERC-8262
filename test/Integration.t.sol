pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";
import {ERC8262Verifier} from "../src/ERC8262Verifier.sol";
import {ERC8262Oracle} from "../src/ERC8262Oracle.sol";
import {IERC8262Oracle} from "../src/interfaces/IERC8262Oracle.sol";
import {ProofTypes} from "../src/libraries/ProofTypes.sol";
import {EIP712CredentialRoot} from "../src/libraries/EIP712CredentialRoot.sol";

/// @title Integration tests using real UltraHonk proofs generated by bb
/// @notice These tests deploy the generated HonkVerifier contracts and verify
///         actual ZK proofs from the Noir circuits, end-to-end.
contract IntegrationTest is Test {
    ERC8262Verifier internal verifier;
    ERC8262Oracle internal oracle;

    address internal owner = makeAddr("owner");
    address internal alice = makeAddr("alice");
    address internal publisher = makeAddr("publisher");

    /// @dev Address baked into compliance/risk_score proof fixtures as the submitter.
    ///      Oracle enforces submitter == msg.sender, so oracle tests must prank as this address.
    address internal constant FIXTURE_SUBMITTER = address(0xdead);

    /// @dev Must match the config_hash baked into the compliance proof fixture.
    ///      This is pedersen_hash([100, 0, 0, 0, 0, 0, 0, 0]) -- the weight config
    ///      used in the test witness (single provider, weight=100).
    bytes32 internal constant FIXTURE_CONFIG_HASH = 0x18574f427f33c6c77af53be06544bd749c9a1db855599d950af61ea613df8405;

    /// @dev Must match the provider_set_hash baked into the compliance proof fixture.
    bytes32 internal constant FIXTURE_PROVIDER_SET_HASH =
        0x14b6becf762f80a24078e62fc9a7eca246b8e406d19962dda817b173f30a94b2;

    /// @dev Merkle root from the membership fixture
    /// (submitter=0xdead bound to set_id=1, salt=0, index=0)
    bytes32 internal constant FIXTURE_MEMBERSHIP_ROOT =
        0x1d7de002251083fdc312a329d46abde0680cbccc27935c33815c18b1beb3da8c;

    /// @dev Merkle root from the non_membership fixture
    /// (submitter=0xdead, set={0x100, 0x10000}, set_id=1, salt=0)
    bytes32 internal constant FIXTURE_NON_MEMBERSHIP_ROOT =
        0x138f818fd4f2eec91e4fd93e14bcc47bc06a3ba333e5a2e7795d0beb752d247c;

    /// @dev Credential root from the attestation fixture
    /// (provider_id=42, submitter=0xdead, KYC basic, attribute=999, expiry=2000000000)
    bytes32 internal constant FIXTURE_TIER_MERKLE_ROOT =
        0x24ce58f9ed6ca066d25f66b15b0eb1dccebe6e457f5aa0fcd353d82d539f5ed5;

    /// @dev Provider id used in the attestation fixture
    uint256 internal constant FIXTURE_PROVIDER_ID = 42;

    /// @dev Oracle address the signed fixtures' provider signatures commit to: the
    ///      second contract this test deploys (CREATE from the default test address,
    ///      nonce 2). Moving the Oracle deployment in setUp invalidates those fixtures.
    address internal constant FIXTURE_ORACLE = 0x2e234DAe75C793f67A35089C9d99245E1C58470b;

    /// @dev signer_pubkey_hash of the signed fixtures' provider key (secp256k1 key
    ///      keccak256("erc8262-integration-fixture-provider-signer")). Signs the
    ///      COMPLIANCE_SIGNED and RISK_SCORE_SIGNED fixtures and slot 0 of the
    ///      COMPLIANCE_MULTI_SIGNED fixture. Registered to provider 1.
    bytes32 internal constant FIXTURE_SIGNER_PUBKEY_HASH =
        0x294fc7a4edbc711b1c3ceceb89474957aea2974dbf3d27efe759a1ecef35d6dc;

    /// @dev signer_pubkey_hash of the second provider key (secp256k1 key
    ///      keccak256("erc8262-integration-fixture-provider-signer-2")), which signs
    ///      slot 2 of the COMPLIANCE_MULTI_SIGNED fixture. Registered to provider 2.
    bytes32 internal constant FIXTURE_SIGNER_B_PUBKEY_HASH =
        0x2eb905640e16a7a7cb2fc08f412e4db744621a9b8ea6c760cedeefc5004e1b20;

    /// @dev Timestamp every signed fixture's provider signed (a public input).
    uint256 internal constant FIXTURE_SIGNED_TIMESTAMP = 1700000000;

    /// @dev Prover-chosen proof timestamp of the risk_score (word 7) and pattern (word 7)
    ///      fixtures (TRUST-24#2); the Oracle enforces MAX_PROOF_AGE on it.
    uint256 internal constant FIXTURE_PROOF_TIMESTAMP = 1700000000;

    function _defaultProviders() internal pure returns (uint256[] memory ps) {
        ps = new uint256[](1);
        ps[0] = 1;
    }

    function setUp() public {
        verifier = new ERC8262Verifier(owner);
        oracle = new ERC8262Oracle(address(verifier), owner, FIXTURE_CONFIG_HASH, _defaultProviders());

        // Deploy all generated verifiers that have a fixture and register them
        string[9] memory circuits = [
            "compliance",
            "risk_score",
            "pattern",
            "attestation",
            "membership",
            "non_membership",
            "compliance_signed",
            "risk_score_signed",
            "compliance_multi_signed"
        ];
        uint8[9] memory types = [
            ProofTypes.COMPLIANCE,
            ProofTypes.RISK_SCORE,
            ProofTypes.PATTERN,
            ProofTypes.ATTESTATION,
            ProofTypes.MEMBERSHIP,
            ProofTypes.NON_MEMBERSHIP,
            ProofTypes.COMPLIANCE_SIGNED,
            ProofTypes.RISK_SCORE_SIGNED,
            ProofTypes.COMPLIANCE_MULTI_SIGNED
        ];

        vm.startPrank(owner);
        for (uint256 i; i < 9; i++) {
            address v = _deployGeneratedVerifier(circuits[i]);
            verifier.setVerifierInitial(types[i], v);
        }

        // Register merkle roots needed by membership/non_membership fixtures
        oracle.registerMerkleRoot(ProofTypes.MEMBERSHIP, FIXTURE_MEMBERSHIP_ROOT);
        oracle.registerMerkleRoot(ProofTypes.NON_MEMBERSHIP, FIXTURE_NON_MEMBERSHIP_ROOT);

        // Register reporting threshold needed by pattern fixture (10000)
        oracle.registerReportingThreshold(bytes32(uint256(10000)));

        // Signed fixture signers (circuits/*_signed/Prover.toml). COMPLIANCE_MULTI_SIGNED
        // counts providers, so its two signers map to two providers.
        oracle.registerSignerPubkeyHash(FIXTURE_SIGNER_PUBKEY_HASH, 1);
        oracle.registerSignerPubkeyHash(FIXTURE_SIGNER_B_PUBKEY_HASH, 2);

        // ATTESTATION fixtures use the per-provider credentials tree (post C-1 redesign).
        // Two-key separation: publisher EOA submits the tx; a separate signing key
        // authorizes the root contents via EIP-712 signature (audit C-1 closure).
        oracle.setProviderPublisher(FIXTURE_PROVIDER_ID, publisher);
        oracle.setCredentialSigner(FIXTURE_PROVIDER_ID, vm.addr(FIXTURE_CREDENTIAL_SIGNER_KEY));

        vm.stopPrank();

        // Warp BEFORE publishing the credential root so the root's TTL aligns with the
        // proof timestamp baked into the fixtures (1700000000).
        vm.warp(1700000000);

        uint64 nb = uint64(block.timestamp);
        uint64 na = uint64(block.timestamp + 1 hours);
        bytes32 digest = EIP712CredentialRoot.toTypedDataHash(
            EIP712CredentialRoot.buildDomainSeparator(address(oracle)),
            FIXTURE_PROVIDER_ID,
            FIXTURE_TIER_MERKLE_ROOT,
            keccak256(""),
            nb,
            na
        );
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(FIXTURE_CREDENTIAL_SIGNER_KEY, digest);
        bytes memory sig = abi.encodePacked(r, s, v);

        vm.prank(publisher);
        oracle.publishCredentialRoot(FIXTURE_PROVIDER_ID, FIXTURE_TIER_MERKLE_ROOT, "", nb, na, sig);
    }

    /// @dev Deterministic test signing key for the integration fixture's credential root.
    uint256 internal constant FIXTURE_CREDENTIAL_SIGNER_KEY =
        uint256(keccak256("erc8262-integration-fixture-credential-signer"));

    // -------------------------------------------------------------------------
    // End-to-end: real proof verification
    // -------------------------------------------------------------------------

    function test_realProof_compliance_verifies() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("compliance");

        bool valid = verifier.verifyProof(ProofTypes.COMPLIANCE, proof, publicInputs);
        assertTrue(valid);
    }

    function test_realProof_compliance_submitAndCheck() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("compliance");

        vm.prank(FIXTURE_SUBMITTER);
        IERC8262Oracle.ComplianceAttestation memory att = oracle.submitCompliance(
            0, // jurisdiction EU (matches fixture)
            ProofTypes.COMPLIANCE,
            proof,
            publicInputs,
            FIXTURE_PROVIDER_SET_HASH
        );

        assertEq(att.subject, FIXTURE_SUBMITTER);
        assertEq(att.jurisdictionId, 0);
        assertTrue(att.meetsThreshold);
        assertEq(att.providerSetHash, FIXTURE_PROVIDER_SET_HASH);
        assertEq(att.verifierUsed, verifier.getVerifier(ProofTypes.COMPLIANCE));

        // checkCompliance should return valid
        (bool valid,) = oracle.checkCompliance(FIXTURE_SUBMITTER, 0);
        assertTrue(valid);

        // Historical proof should be retrievable
        IERC8262Oracle.ComplianceAttestation memory historical =
            oracle.getHistoricalProof(oracle.computeProofHash(proof, ProofTypes.COMPLIANCE));
        assertEq(historical.subject, FIXTURE_SUBMITTER);
    }

    function test_realProof_compliance_replayReverts() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("compliance");
        bytes32 expectedHash = oracle.computeProofHash(proof, ProofTypes.COMPLIANCE);

        vm.prank(FIXTURE_SUBMITTER);
        oracle.submitCompliance(0, ProofTypes.COMPLIANCE, proof, publicInputs, FIXTURE_PROVIDER_SET_HASH);

        // Same proof should be rejected
        vm.prank(FIXTURE_SUBMITTER);
        vm.expectRevert(abi.encodeWithSelector(ERC8262Oracle.ProofAlreadyUsed.selector, expectedHash));
        oracle.submitCompliance(0, ProofTypes.COMPLIANCE, proof, publicInputs, FIXTURE_PROVIDER_SET_HASH);
    }

    function test_realProof_compliance_wrongJurisdictionReverts() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("compliance");

        // Fixture has jurisdiction_id=0 (EU), try submitting as UK (2). Both are
        // permissive jurisdictions so the PublicInputMismatch check fires before any
        // signed-signals policy check.
        vm.prank(FIXTURE_SUBMITTER);
        vm.expectRevert(ERC8262Oracle.PublicInputMismatch.selector);
        oracle.submitCompliance(2, ProofTypes.COMPLIANCE, proof, publicInputs, FIXTURE_PROVIDER_SET_HASH);
    }

    function test_realProof_compliance_corruptedProofFails() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("compliance");

        // Corrupt one byte of the proof
        proof[42] = proof[42] ^ 0xff;

        // Corrupted proof should revert (verifier reverts on invalid proofs)
        vm.prank(FIXTURE_SUBMITTER);
        vm.expectRevert();
        oracle.submitCompliance(0, ProofTypes.COMPLIANCE, proof, publicInputs, FIXTURE_PROVIDER_SET_HASH);
    }

    // -------------------------------------------------------------------------
    // End-to-end: risk_score proof
    // -------------------------------------------------------------------------

    function test_realProof_riskScore_verifies() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("risk_score");
        bool valid = verifier.verifyProof(ProofTypes.RISK_SCORE, proof, publicInputs);
        assertTrue(valid);
    }

    function test_realProof_riskScore_submitAndCheck() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("risk_score");
        vm.prank(FIXTURE_SUBMITTER);
        IERC8262Oracle.ComplianceAttestation memory att =
            oracle.submitCompliance(0, ProofTypes.RISK_SCORE, proof, publicInputs, bytes32(0));
        assertEq(att.subject, FIXTURE_SUBMITTER);
        assertTrue(att.meetsThreshold);
        assertEq(oracle.lastProofTimestampByType(FIXTURE_SUBMITTER, 0, ProofTypes.RISK_SCORE), FIXTURE_PROOF_TIMESTAMP);
    }

    /// @dev Demo for TRUST-24#2: a real 0x02 proof older than MAX_PROOF_AGE reverts.
    function test_realProof_riskScore_revert_stale() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("risk_score");
        uint256 later = FIXTURE_PROOF_TIMESTAMP + oracle.MAX_PROOF_AGE() + 1;
        vm.warp(later);
        vm.prank(FIXTURE_SUBMITTER);
        vm.expectRevert(
            abi.encodeWithSelector(ERC8262Oracle.ProofTimestampStale.selector, FIXTURE_PROOF_TIMESTAMP, later)
        );
        oracle.submitCompliance(0, ProofTypes.RISK_SCORE, proof, publicInputs, bytes32(0));
    }

    function test_realProof_riskScore_revert_future() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("risk_score");
        uint256 earlier = FIXTURE_PROOF_TIMESTAMP - 1;
        vm.warp(earlier);
        vm.prank(FIXTURE_SUBMITTER);
        vm.expectRevert(
            abi.encodeWithSelector(ERC8262Oracle.ProofTimestampInFuture.selector, FIXTURE_PROOF_TIMESTAMP, earlier)
        );
        oracle.submitCompliance(0, ProofTypes.RISK_SCORE, proof, publicInputs, bytes32(0));
    }

    function test_realProof_riskScore_redatedTimestampFailsVerification() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("risk_score");
        // Relabel the proof with a fresh timestamp (word 7): the Oracle's window would
        // accept it, but the timestamp is bound in the transcript, so it no longer verifies.
        bytes memory redated = bytes.concat(
            _slice(publicInputs, 0, 7 * 32),
            bytes32(FIXTURE_PROOF_TIMESTAMP + 1 days),
            _slice(publicInputs, 8 * 32, publicInputs.length)
        );
        try verifier.verifyProof(ProofTypes.RISK_SCORE, proof, redated) returns (bool valid) {
            assertFalse(valid, "re-dated RISK_SCORE proof verified");
        } catch { /* revert acceptable */ }
    }

    // -------------------------------------------------------------------------
    // End-to-end: pattern (PATTERN) proof
    // -------------------------------------------------------------------------

    function test_realProof_pattern_verifies() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("pattern");
        bool valid = verifier.verifyProof(ProofTypes.PATTERN, proof, publicInputs);
        assertTrue(valid);
    }

    function test_realProof_pattern_submitAndCheck() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("pattern");
        vm.prank(FIXTURE_SUBMITTER);
        IERC8262Oracle.ComplianceAttestation memory att =
            oracle.submitCompliance(0, ProofTypes.PATTERN, proof, publicInputs, bytes32(0));
        assertEq(att.subject, FIXTURE_SUBMITTER);
        assertTrue(att.meetsThreshold);
        assertEq(oracle.lastProofTimestampByType(FIXTURE_SUBMITTER, 0, ProofTypes.PATTERN), FIXTURE_PROOF_TIMESTAMP);
    }

    function test_realProof_pattern_revert_stale() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("pattern");
        uint256 later = FIXTURE_PROOF_TIMESTAMP + oracle.MAX_PROOF_AGE() + 1;
        vm.warp(later);
        vm.prank(FIXTURE_SUBMITTER);
        vm.expectRevert(
            abi.encodeWithSelector(ERC8262Oracle.ProofTimestampStale.selector, FIXTURE_PROOF_TIMESTAMP, later)
        );
        oracle.submitCompliance(0, ProofTypes.PATTERN, proof, publicInputs, bytes32(0));
    }

    function test_realProof_pattern_revert_future() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("pattern");
        uint256 earlier = FIXTURE_PROOF_TIMESTAMP - 1;
        vm.warp(earlier);
        vm.prank(FIXTURE_SUBMITTER);
        vm.expectRevert(
            abi.encodeWithSelector(ERC8262Oracle.ProofTimestampInFuture.selector, FIXTURE_PROOF_TIMESTAMP, earlier)
        );
        oracle.submitCompliance(0, ProofTypes.PATTERN, proof, publicInputs, bytes32(0));
    }

    function test_realProof_pattern_redatedTimestampFailsVerification() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("pattern");
        // Word 7 (the last word) is the timestamp.
        bytes memory redated = bytes.concat(_slice(publicInputs, 0, 7 * 32), bytes32(FIXTURE_PROOF_TIMESTAMP + 1 days));
        try verifier.verifyProof(ProofTypes.PATTERN, proof, redated) returns (bool valid) {
            assertFalse(valid, "re-dated PATTERN proof verified");
        } catch { /* revert acceptable */ }
    }

    // -------------------------------------------------------------------------
    // End-to-end: attestation (ATTESTATION) proof
    // -------------------------------------------------------------------------

    function test_realProof_attestation_verifies() public {
        (bytes memory proof, bytes memory publicInputs) = _loadFixture("attestation");
